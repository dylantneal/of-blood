  "lines": [
    { "time": 0, "text": null, "section": "intro" },
    { "time": 20, "text": null, "section": "verse1" },
    { "time": 20, "text": "Cathedral nebulae dilate" },
    { "time": 21, "text": "Coronal irises aflame" },
    { "time": 23, "text": "Billions burn as single photons" },
    { "time": 26, "text": "Brand their sins upon your name" },
    { "time": 28, "text": "I crawl the spiral cloister" },
    { "time": 31, "text": "Ribs a rosary of rust" },
    { "time": 33, "text": "While hymns of optic nerve vivisection" },
    { "time": 35, "text": "Grind creation into dust" },
    { "time": 38, "text": null, "section": "bridge" },
    { "time": 38, "text": "Every breath a verdict" },
    { "time": 40, "text": "Every heartbeat, thin reprieve" },
    { "time": 42, "text": "My marrow turns to candles" },
    { "time": 44, "text": "In the furnace of belief" },
    { "time": 46, "text": null, "section": "chorus1" },
    { "time": 46, "text": "Ensnared in the malevolent stare of infinity" },
    { "time": 51, "text": "Writhing where omniscient shutters refuse to blink" },
    { "time": 55, "text": "No horizon, only pupil, infinite and merciless" },
    { "time": 60, "text": "Ascension mutates to chains of sanctified light" },
    { "time": 64, "text": "And I burn in the glare of eternity" },
    { "time": 68, "text": null, "section": "verse2" },
    { "time": 68, "text": "Seraphs perch like vultures on the fractured lens of dawn" },
    { "time": 73, "text": "Halo-scalpels carve commandments through the parchment of my palms" },
    { "time": 77, "text": "Epiphanies drip formaldehyde, embalming hope in glass" },
    { "time": 82, "text": "A paradise of cataracts where newborn angels suffocate in mass" },
    { "time": 95, "text": null, "section": "chorus2" },
    { "time": 95, "text": "Ensnared in the malevolent stare of infinity" },
    { "time": 99, "text": "Writhing where omniscient shutters refuse to blink" },
    { "time": 104, "text": "No horizon, only pupil, infinite and merciless" },
    { "time": 108, "text": "Ascension mutates to chains of sanctified light" },
    { "time": 112, "text": "And I drown in the depths of divinity" },
    { "time": 117, "text": null, "section": "verse3" },
    { "time": 117, "text": "Through retinal labyrinths I stagger" },
    { "time": 119, "text": "Stripped of faith and frame" },
    { "time": 122, "text": "Synaptic scriptures sear my spine" },
    { "time": 123, "text": "Commandments etched in flame" },
    { "time": 125, "text": "The glare distills my mass into prisms of shattered lore" },
    { "time": 130, "text": "As my shadow moulted of its eyelids" },
    { "time": 133, "text": "Crawls to kneel once more" },
    { "time": 137, "text": null, "section": "interlude" },
    { "time": 137, "text": "Eyes within eyes within eyes" },
    { "time": 141, "text": "Galactic roulette of fates" },
    { "time": 146, "text": "Observation is annihilation" },
    { "time": 150, "text": "Witness becomes warden of self-negation" },
    { "time": 154, "text": "May the sightless find release…" },
    { "time": 159, "text": "May the watchful rot in light…" },
    { "time": 163, "text": "Eyes to ashes" },
    { "time": 167, "text": "Faith into night" }
  ]
}



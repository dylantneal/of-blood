    "lucide-react": "^0.344.0",
    "next": "^16.0.7",
    "node-id3": "^0.2.9",
    "postcss-import": "^16.1.1",
    "postcss-nesting": "^13.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^3.2.0",
